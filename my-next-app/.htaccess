# Frontend .htaccess for cPanel - Place in public_html/www/ or public_html/
# ACM Website - Next.js Static Export

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Skip rewrite for existing directories and files
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  
  # Rewrite all requests to index.html for Next.js routing
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Compression for faster loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache headers for static assets
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$">
  Header set Cache-Control "max-age=31536000, public"
  Header set Expires "Thu, 31 Dec 2037 23:55:55 GMT"
</FilesMatch>

# Cache headers for HTML files (shorter duration)
<FilesMatch "\.(html)$">
  Header set Cache-Control "max-age=3600, must-revalidate"
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# Disable directory listing
Options -Indexes

# Prevent access to sensitive files
<FilesMatch "(\.env|\.env\.|package\.json|package-lock\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>
