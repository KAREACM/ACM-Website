# Backend API .htaccess for cPanel
# This will be auto-generated by cPanel Node.js setup, but you can customize it

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Don't rewrite existing files and directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Proxy to Node.js application running on port 5000
  # Update 127.0.0.1 and 5000 to match your setup
  RewriteRule ^(.*)$ http://127.0.0.1:5000/$1 [P,L]
</IfModule>

# Enable mod_proxy if needed
<IfModule mod_proxy.c>
  ProxyRequests Off
  ProxyPreserveHost On
  ProxyPassReverse / http://127.0.0.1:5000/
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent direct access to sensitive files
<FilesMatch "(\.env|\.env\.|package\.json|package-lock\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>
